---
import type { Dictionary } from '../i18n';
import SectionIntro from './SectionIntro.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section section--alt" id="process">
  <div class="container">
    <SectionIntro index="05" eyebrow={t.process.eyebrow} title={t.process.title} lead={t.process.lead} />
    <ol class="steps">
      {
        t.process.steps.map((step, index) => (
          <li data-reveal style={`--d:${index * 70}ms`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    display: grid;
    margin: 2.5rem 0 0;
    padding: 0;
    position: relative;
  }

  .steps li {
    position: relative;
    padding: 0 0 1.6rem 1.5rem;
    border-left: 1px solid var(--line);
  }

  .steps li:last-child {
    padding-bottom: 0;
  }

  .steps li::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.35rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 6px rgba(196, 181, 253, 0.12);
  }

  .steps span {
    display: block;
    margin-bottom: 0.55rem;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .steps h3 {
    margin-bottom: 0.35rem;
    font-size: 1.3rem;
  }

  .steps p {
    color: var(--muted);
    max-width: 28rem;
  }

  @media (min-width: 960px) {
    .steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1rem;
      border-left: 0;
    }

    .steps::before {
      content: '';
      position: absolute;
      top: 0.55rem;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, var(--accent-2), var(--accent-3), transparent);
    }

    .steps li {
      border-left: 0;
      padding: 0;
    }

    .steps li::before {
      left: 0;
      top: 0.35rem;
    }

    .steps span,
    .steps h3,
    .steps p {
      padding-top: 0;
    }

    .steps span {
      margin: 1.5rem 0 0.85rem;
    }
  }
</style>
