---
import type { Dictionary } from '../i18n';
import SectionIntro from './SectionIntro.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section" id="process" data-process>
  <div class="container">
    <SectionIntro
      index={t.process.index}
      eyebrow={t.process.eyebrow}
      title={t.process.title}
      lead={t.process.lead}
    />

    <div class="process" data-reveal>
      <ol class="process__nav">
        {
          t.process.steps.map((step, index) => (
            <li>
              <button type="button" data-process-tab aria-selected={index === 0 ? 'true' : 'false'}>
                <span>0{index + 1}</span>
                {step.title}
              </button>
            </li>
          ))
        }
      </ol>

      <div class="process__panels">
        {
          t.process.steps.map((step, index) => (
            <article class="process__panel" data-process-panel hidden={index !== 0}>
              <p class="process__n">0{index + 1}</p>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              <p class="process__gets">
                <strong>{t.process.gets}</strong>
                {step.gets}
              </p>
            </article>
          ))
        }
      </div>
    </div>

    <ol class="process-mobile">
      {
        t.process.steps.map((step, index) => (
          <li data-reveal style={`--d:${index * 40}ms`}>
            <span>0{index + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              <p class="process__gets">
                <strong>{t.process.gets}</strong>
                {step.gets}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    display: none;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .process__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
  }

  .process__nav button {
    width: 100%;
    min-height: 5.6rem;
    padding: 0.9rem 0.7rem;
    border: 0;
    border-right: 1px solid var(--line);
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  .process__nav li:last-child button {
    border-right: 0;
  }

  .process__nav button[aria-selected='true'] {
    background: rgba(104, 136, 255, 0.1);
  }

  .process__nav span {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .process__nav button {
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .process__panels {
    min-height: 14rem;
    padding: 1.8rem 1.7rem 2rem;
  }

  .process__panel h3 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .process__panel > p,
  .process-mobile p {
    color: var(--muted);
    max-width: 40rem;
  }

  .process__n {
    font-family: var(--mono);
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .process__gets {
    margin-top: 1.1rem;
    color: var(--text) !important;
  }

  .process__gets strong {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .process-mobile {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .process-mobile li {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0.85rem;
    padding: 1.2rem 0;
    border-top: 1px solid var(--line);
  }

  .process-mobile li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .process-mobile span {
    font-family: var(--mono);
    color: var(--accent);
    font-size: 0.8rem;
  }

  .process-mobile h3 {
    margin-bottom: 0.4rem;
    font-size: 1.2rem;
  }

  @media (min-width: 1024px) {
    .process {
      display: block;
    }

    .process-mobile {
      display: none;
    }
  }
</style>
