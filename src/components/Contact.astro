---
import type { Dictionary, Locale } from '../i18n';
import { contacts } from '../data/contacts';
import SectionIntro from './SectionIntro.astro';

interface Props {
  locale: Locale;
  t: Dictionary;
}

const { locale, t } = Astro.props;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';

const channels = [
  { key: 'email', ...contacts.email, label: t.channels.email },
  { key: 'whatsapp', ...contacts.whatsapp, label: t.channels.whatsapp },
  { key: 'telegram', ...contacts.telegram, label: t.channels.telegram },
] as const;
---

<section class="section section--tight cta" id="contact">
  <div class="container">
    <SectionIntro index={t.cta.index} eyebrow={t.cta.eyebrow} title={t.cta.title} lead={t.cta.lead} />

    <div class="cta__grid">
      <div class="cta__channels" data-reveal>
        <p class="cta__label">{t.cta.channels}</p>
        <ul>
          {
            channels.map((item) => (
              <li>
                <a href={item.href} target={item.key === 'email' ? undefined : '_blank'} rel={item.key === 'email' ? undefined : 'noopener noreferrer'}>
                  <span>{item.label}</span>
                  <strong>{item.value}</strong>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="cta__legal">{t.why.legal}</p>
      </div>

      <form class="form" data-contact-form data-reveal novalidate>
        <input type="text" name="company" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="locale" value={locale} />

        <label class="field">
          <span>{t.form.name}</span>
          <input name="name" type="text" required maxlength="80" placeholder={t.form.namePlaceholder} />
          <small class="field__error" data-error></small>
        </label>

        <label class="field">
          <span>{t.form.sector}</span>
          <select name="sector" required>
            <option value="private">{t.form.sectorPrivate}</option>
            <option value="gov">{t.form.sectorGov}</option>
            <option value="other">{t.form.sectorOther}</option>
          </select>
          <small class="field__error" data-error></small>
        </label>

        <label class="field">
          <span>{t.form.interest}</span>
          <select name="interest" required>
            <option value="turnkey">{t.form.interestTurnkey}</option>
            <option value="ecommerce">{t.form.interestEcommerce}</option>
            <option value="crm">{t.form.interestCrm}</option>
            <option value="bots">{t.form.interestBots}</option>
            <option value="automation">{t.form.interestAutomation}</option>
            <option value="support">{t.form.interestSupport}</option>
            <option value="other">{t.form.interestOther}</option>
          </select>
          <small class="field__error" data-error></small>
        </label>

        <label class="field">
          <span>{t.form.contact}</span>
          <input name="contact" type="text" required maxlength="80" placeholder={t.form.contactPlaceholder} />
          <small class="field__error" data-error></small>
        </label>

        <label class="field field--full">
          <span>{t.form.message}</span>
          <textarea name="message" rows="4" required maxlength="2000" placeholder={t.form.messagePlaceholder}></textarea>
          <small class="field__error" data-error></small>
        </label>

        <div class="form__actions">
          <button class="btn btn--primary" type="submit" data-submit>
            <span data-submit-label>{t.form.submit}</span>
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
          <p class="form__status" data-status role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<script
  define:vars={{
    endpoint,
    successText: t.form.success,
    errorText: t.form.error,
    sendingText: t.form.sending,
    submitText: t.form.submit,
    requiredText: t.form.required,
  }}
>
  const form = document.querySelector('[data-contact-form]');

  const setInterest = (value) => {
    if (!(form instanceof HTMLFormElement)) return;
    const select = form.elements.namedItem('interest');
    if (select instanceof HTMLSelectElement && [...select.options].some((o) => o.value === value)) {
      select.value = value;
    }
  };

  document.querySelectorAll('[data-interest]').forEach((el) => {
    el.addEventListener('click', () => {
      const value = el.getAttribute('data-interest');
      if (value) setInterest(value);
    });
  });

  if (form instanceof HTMLFormElement) {
    const status = form.querySelector('[data-status]');
    const submit = form.querySelector('[data-submit]');

    const clearErrors = () => {
      form.querySelectorAll('.field').forEach((field) => {
        field.classList.remove('is-invalid');
        const err = field.querySelector('[data-error]');
        if (err) err.textContent = '';
      });
    };

    const validate = () => {
      clearErrors();
      let ok = true;
      const controls = [...form.elements].filter((el) => {
        return el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement;
      });

      for (const el of controls) {
        if (el.name === 'company' || el.name === 'locale' || el.type === 'hidden') continue;
        if (el instanceof HTMLInputElement && el.classList.contains('hp')) continue;
        if (!el.checkValidity()) {
          ok = false;
          const field = el.closest('.field');
          field?.classList.add('is-invalid');
          const err = field?.querySelector('[data-error]');
          if (err) err.textContent = requiredText;
        }
      }
      return ok;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(status instanceof HTMLElement) || !(submit instanceof HTMLButtonElement)) return;

      const data = new FormData(form);
      if (String(data.get('company') || '').trim()) {
        status.textContent = successText;
        status.dataset.state = 'ok';
        form.reset();
        return;
      }

      if (!validate()) {
        status.textContent = '';
        status.dataset.state = '';
        return;
      }

      if (!endpoint) {
        status.textContent = errorText;
        status.dataset.state = 'error';
        return;
      }

      const label = submit.querySelector('[data-submit-label]');
      submit.disabled = true;
      submit.dataset.loading = 'true';
      if (label) label.textContent = sendingText;
      status.textContent = '';
      status.dataset.state = '';

      try {
        const payload = {
          name: String(data.get('name') || '').trim(),
          sector: String(data.get('sector') || '').trim(),
          interest: String(data.get('interest') || '').trim(),
          contact: String(data.get('contact') || '').trim(),
          message: String(data.get('message') || '').trim(),
          locale: String(data.get('locale') || '').trim(),
        };

        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) throw new Error('fail');
        status.textContent = successText;
        status.dataset.state = 'ok';
        form.reset();
        clearErrors();
      } catch {
        status.textContent = errorText;
        status.dataset.state = 'error';
      } finally {
        submit.disabled = false;
        submit.dataset.loading = 'false';
        if (label) label.textContent = submitText;
      }
    });
  }
</script>

<style>
  .cta {
    background:
      radial-gradient(720px 280px at 80% 0%, rgba(75, 108, 255, 0.14), transparent 60%),
      var(--bg);
  }

  .cta__grid {
    display: grid;
    gap: 2rem;
  }

  .cta__label {
    margin-bottom: 1rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .cta__channels ul {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  .cta__channels li + li {
    border-top: 1px solid var(--line);
  }

  .cta__channels a {
    display: grid;
    gap: 0.2rem;
    padding: 0.95rem 0;
  }

  .cta__channels a span {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .cta__channels a:hover strong {
    color: var(--accent);
  }

  .cta__legal {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .form {
    display: grid;
    gap: 0.85rem;
    padding: 1.35rem;
    border: 1px solid var(--line);
    background: rgba(17, 23, 34, 0.86);
    box-shadow: var(--shadow);
  }

  .form__actions {
    display: grid;
    gap: 0.75rem;
  }

  .form__status[data-state='ok'] {
    color: var(--success);
  }

  .form__status[data-state='error'] {
    color: var(--danger);
  }

  @media (min-width: 768px) {
    .form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .field--full,
    .form__actions {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 980px) {
    .cta__grid {
      grid-template-columns: 0.75fr 1.25fr;
      align-items: start;
      gap: 3rem;
    }
  }
</style>
