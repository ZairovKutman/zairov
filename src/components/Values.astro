---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section values" id="values">
  <div class="container">
    <p class="section__eyebrow">{t.values.eyebrow}</p>
    <h2 class="section__title">{t.values.title}</h2>
    <div class="values__grid">
      {
        t.values.items.map((item) => (
          <article class="value">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .values__grid {
    display: grid;
    gap: 1.25rem;
  }

  .value {
    padding: 0.25rem 0 0.5rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  .value h3 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
    color: var(--color-accent);
  }

  .value p {
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .values__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 2rem;
    }
  }

  @media (min-width: 1024px) {
    .values__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
