---
import type { Dictionary } from '../i18n';
import SectionIntro from './SectionIntro.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section" id="solutions">
  <div class="container">
    <SectionIntro
      index={t.solutions.index}
      eyebrow={t.solutions.eyebrow}
      title={t.solutions.title}
      lead={t.solutions.lead}
    />

    <ol class="solutions">
      {
        t.solutions.items.map((item, index) => (
          <li class="solution" data-reveal style={`--d:${index * 45}ms`}>
            <span>0{index + 1}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .solutions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .solution {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.9rem;
    padding: 1.35rem 1.2rem;
    background: var(--bg);
  }

  .solution span {
    font-family: var(--mono);
    color: var(--accent);
    font-size: 0.82rem;
    padding-top: 0.2rem;
  }

  .solution h3 {
    margin-bottom: 0.45rem;
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
  }

  .solution p {
    color: var(--muted);
    max-width: 34rem;
  }

  @media (min-width: 800px) {
    .solutions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1180px) {
    .solutions {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
