---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  lead?: string;
}

const { index, eyebrow, title, lead } = Astro.props;
---

<header class="intro" data-reveal>
  <p class="kicker"><span class="kicker__n">{index}</span>{eyebrow}</p>
  <h2 class="intro__title">{title}</h2>
  {lead && <p class="intro__lead">{lead}</p>}
</header>
