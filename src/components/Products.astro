---
import type { Dictionary } from '../i18n';
import SectionIntro from './SectionIntro.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section section--paper" id="products">
  <div class="container services">
    <SectionIntro index="01" eyebrow={t.services.eyebrow} title={t.services.title} lead={t.services.lead} />
    <ol class="services__list">
      {
        t.services.items.map((item, index) => (
          <li class="service" data-reveal style={`--d:${index * 60}ms`}>
            <span class="service__n">{String(index + 1).padStart(2, '0')}</span>
            <div class="service__body">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <p class="service__meta">{item.includes.join(' · ')}</p>
            </div>
            <a class="link service__go" href="#contact" data-interest={item.interest}>
              {t.services.discuss}
              <span class="link__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .services {
    display: grid;
    gap: 2rem;
  }

  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--paper-line);
  }

  .service {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 1rem;
    align-items: start;
    padding: 1.35rem 0 1.35rem 0.85rem;
    border-top: 1px solid var(--paper-line);
  }

  .service::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--signal);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 220ms var(--ease);
  }

  .service:hover::before,
  .service:focus-within::before {
    transform: scaleY(1);
  }

  .service__n {
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--signal);
    padding-top: 0.25rem;
  }

  .service__body h3 {
    margin-bottom: 0.4rem;
    font-size: 1.35rem;
  }

  .service__body p {
    color: var(--paper-muted);
  }

  .service__meta {
    margin-top: 0.55rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--paper-ink);
  }

  .service__go {
    grid-column: 2;
    margin-top: 0.35rem;
  }

  @media (min-width: 800px) {
    .service {
      grid-template-columns: 3.5rem minmax(0, 1fr) auto;
      align-items: center;
      gap: 1.25rem;
      padding-block: 1.6rem;
    }

    .service__go {
      grid-column: auto;
      margin-top: 0;
    }
  }

  @media (min-width: 1100px) {
    .services {
      grid-template-columns: minmax(16rem, 0.72fr) minmax(0, 1.28fr);
      gap: 4rem;
      align-items: start;
    }

    .services :global(.intro) {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
</style>
