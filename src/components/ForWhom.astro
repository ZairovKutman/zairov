---
import type { Dictionary } from '../i18n';
import SectionIntro from './SectionIntro.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section section--paper" id="solutions">
  <div class="container">
    <SectionIntro index="03" eyebrow={t.solutions.eyebrow} title={t.solutions.title} lead={t.solutions.lead} />
    <ol class="solutions">
      {
        t.solutions.items.map((item, index) => (
          <li data-reveal style={`--d:${index * 50}ms`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.fit}</p>
            </div>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .solutions {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--paper-line);
  }

  .solutions li {
    display: grid;
    gap: 0.35rem 1rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--paper-line);
  }

  .solutions span {
    font-family: var(--font-display);
    color: var(--signal);
    font-size: 0.85rem;
  }

  .solutions h3 {
    font-size: 1.35rem;
  }

  .solutions li > div p {
    color: var(--paper-muted);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .solutions li > p {
    color: var(--paper-muted);
    max-width: 38rem;
  }

  @media (min-width: 800px) {
    .solutions li {
      grid-template-columns: 3rem minmax(12rem, 0.7fr) minmax(0, 1.3fr);
      align-items: baseline;
      padding-block: 1.45rem;
    }
  }
</style>
