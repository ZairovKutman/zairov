---
import type { Dictionary } from '../i18n';
import SectionIntro from './SectionIntro.astro';
import Study from './Study.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const [lead, ...rest] = t.work.items;

const statusLabel = (status: string) => (status === 'internal' ? t.work.statusInternal : t.work.statusLive);
---

<section class="section" id="cases">
  <div class="container">
    <SectionIntro index="03" eyebrow={t.work.eyebrow} title={t.work.title} lead={t.work.lead} />

    <article class="feature" data-reveal>
      {
        lead.url ? (
          <figure class="shot">
            <img
              src={`${import.meta.env.BASE_URL}work/${lead.id}.webp`}
              alt={lead.name}
              width="1200"
              height="750"
              loading="eager"
              decoding="async"
            />
          </figure>
        ) : (
          <Study id={lead.id} label={t.work.study} />
        )
      }
      <div class="feature__copy">
        <p class="feature__meta">
          <span>01</span>
          <span>{lead.kind}</span>
          <span class="feature__status">{statusLabel(lead.status)}</span>
        </p>
        <h3 class="display feature__name">{lead.name}</h3>
        <p class="feature__text">{lead.text}</p>
        {
          lead.url ? (
            <a class="link" href={lead.url} target="_blank" rel="noopener noreferrer">
              {t.work.visit}
              <span class="sr-only">
                , {lead.name}. {t.a11y.external}
              </span>
              <span class="link__arrow" aria-hidden="true">↗</span>
            </a>
          ) : (
            <p class="feature__internal">{t.work.internal}</p>
          )
        }
      </div>
    </article>

    <div class="work">
      {
        rest.map((item, index) => (
          <article class="work__item" data-reveal style={`--d:${index * 70}ms`}>
            {item.url ? (
              <figure class="shot">
                <img
                  src={`${import.meta.env.BASE_URL}work/${item.id}.webp`}
                  alt={item.name}
                  width="1200"
                  height="750"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ) : (
              <Study id={item.id} label={t.work.study} />
            )}
            <div class="work__copy">
              <p class="work__meta">
                <span>{String(index + 2).padStart(2, '0')}</span>
                <span>{item.kind}</span>
                <span>{statusLabel(item.status)}</span>
              </p>
              <h3 class="display work__name">{item.name}</h3>
              <p>{item.text}</p>
              {item.url ? (
                <a class="link" href={item.url} target="_blank" rel="noopener noreferrer">
                  {t.work.visit}
                  <span class="sr-only">
                    , {item.name}. {t.a11y.external}
                  </span>
                  <span class="link__arrow" aria-hidden="true">↗</span>
                </a>
              ) : (
                <p class="work__internal">{t.work.internal}</p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .feature {
    display: grid;
    gap: 0;
    margin-top: 2.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1.5rem;
    background: var(--bg-raise);
  }

  .feature__copy,
  .work__copy {
    padding: 1.4rem 1.35rem 1.5rem;
  }

  .feature__meta,
  .work__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
    margin-bottom: 0.75rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .feature__meta span:first-child,
  .work__meta span:first-child,
  .feature__status {
    color: var(--accent);
  }

  .feature__name {
    margin-bottom: 0.8rem;
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    max-width: 12ch;
  }

  .feature__text,
  .work__item p {
    max-width: 36rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .feature__internal,
  .work__internal {
    color: var(--ink);
    font-weight: 600;
  }

  .work {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  .work__item {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1.35rem;
    background: rgba(27, 11, 50, 0.55);
  }

  .work__name {
    margin-bottom: 0.45rem;
    font-size: clamp(1.6rem, 2.4vw, 2.15rem);
  }

  .shot {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #0a0314;
  }

  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 700ms var(--ease);
  }

  .work__item:hover .shot img,
  .feature:hover .shot img {
    transform: scale(1.035);
  }

  @media (min-width: 800px) {
    .feature {
      grid-template-columns: 1.15fr 0.85fr;
      min-height: 28rem;
    }

    .feature__copy {
      display: grid;
      align-content: end;
      padding: 2rem 2rem 2.1rem 1.8rem;
    }

    .feature .shot {
      min-height: 100%;
      aspect-ratio: auto;
    }

    .work__item {
      grid-template-columns: 1.05fr 0.95fr;
    }

    .work__item:nth-child(even) .shot {
      order: 2;
    }

    .work__copy {
      display: grid;
      align-content: center;
      padding: 1.8rem;
    }
  }
</style>
