---
import type { Dictionary } from '../i18n';
import SectionIntro from './SectionIntro.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section section--alt" id="products">
  <div class="container services">
    <SectionIntro index="02" eyebrow={t.services.eyebrow} title={t.services.title} lead={t.services.lead} />
    <ol class="services__list">
      {
        t.services.items.map((item, index) => (
          <li class={`service service--${item.id}`} data-reveal style={`--d:${index * 70}ms`}>
            <div class="service__visual" aria-hidden="true"></div>
            <div class="service__body">
              <span class="service__n">{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <p class="service__meta">{item.includes.join(' · ')}</p>
              <a class="link service__go" href="#contact" data-interest={item.interest}>
                {t.services.discuss}
                <span class="link__arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .services {
    display: grid;
    gap: 2.25rem;
  }

  .services__list {
    list-style: none;
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .service {
    position: relative;
    display: grid;
    gap: 1.1rem;
    min-height: 16rem;
    padding: 1.35rem 1.3rem 1.25rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, rgba(246, 243, 251, 0.04), rgba(16, 5, 30, 0.2)),
      var(--bg-raise);
    transition:
      border-color 220ms var(--ease),
      transform 220ms var(--ease),
      box-shadow 220ms var(--ease);
  }

  .service:hover,
  .service:focus-within {
    border-color: rgba(196, 181, 253, 0.45);
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(76, 29, 149, 0.28);
  }

  .service__n {
    display: block;
    margin-bottom: 0.7rem;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .service__body h3 {
    margin-bottom: 0.5rem;
    font-size: 1.4rem;
  }

  .service__body p {
    color: var(--muted);
  }

  .service__meta {
    margin-top: 0.8rem;
    color: var(--ink) !important;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .service__go {
    margin-top: 0.35rem;
  }

  .service__visual {
    position: relative;
    min-height: 4.8rem;
    border-radius: 0.9rem;
    background: rgba(246, 243, 251, 0.03);
    overflow: hidden;
  }

  .service__visual::before,
  .service__visual::after {
    content: '';
    position: absolute;
  }

  .service--sites .service__visual::before {
    inset: 0.7rem 0.8rem auto;
    height: 0.45rem;
    width: 42%;
    border-radius: 99px;
    background: #fff;
  }

  .service--sites .service__visual::after {
    inset: 1.5rem 0.8rem 0.7rem;
    border: 1px solid rgba(246, 243, 251, 0.2);
    border-radius: 0.4rem;
    background: linear-gradient(180deg, rgba(91, 140, 255, 0.35), transparent);
  }

  .service--crm .service__visual {
    background:
      linear-gradient(to bottom, rgba(246, 243, 251, 0.12) 1px, transparent 1px) 0 18px / 100% 18px,
      rgba(246, 243, 251, 0.03);
  }

  .service--crm .service__visual::before {
    left: 0.8rem;
    top: 0.7rem;
    width: 28%;
    height: 0.4rem;
    border-radius: 99px;
    background: var(--accent-3);
  }

  .service--retail .service__visual {
    background:
      linear-gradient(to right, rgba(246, 243, 251, 0.08) 1px, transparent 1px) 0 0 / 33% 100%,
      linear-gradient(to bottom, rgba(246, 243, 251, 0.08) 1px, transparent 1px) 0 0 / 100% 50%,
      rgba(246, 243, 251, 0.03);
  }

  .service--retail .service__visual::after {
    right: 12%;
    bottom: 18%;
    width: 22%;
    aspect-ratio: 1;
    border-radius: 0.35rem;
    background: var(--accent-2);
  }

  .service--ai .service__visual::before {
    inset: 50% auto auto 50%;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0 18%, rgba(232, 74, 255, 0.55) 18% 42%, transparent 43%);
    transform: translate(-50%, -50%);
    box-shadow: 0 0 32px rgba(232, 74, 255, 0.45);
  }

  .service--integrations .service__visual::before,
  .service--integrations .service__visual::after {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .service--integrations .service__visual::before {
    left: 18%;
    top: 38%;
    box-shadow:
      4.5rem -0.6rem 0 var(--accent-2),
      2.2rem 1.1rem 0 #fff;
  }

  .service--integrations .service__visual::after {
    left: 22%;
    right: 22%;
    top: 48%;
    height: 1px;
    width: auto;
    background: rgba(246, 243, 251, 0.28);
  }

  .service--support .service__visual::before {
    inset: 0.85rem 1.1rem;
    border: 1px solid rgba(196, 181, 253, 0.55);
    border-radius: 1.1rem 1.1rem 1.4rem 1.4rem;
  }

  .service--support .service__visual::after {
    left: 50%;
    top: 42%;
    width: 36%;
    height: 0.35rem;
    border-radius: 99px;
    background: var(--ok);
    transform: translateX(-50%);
  }

  @media (min-width: 800px) {
    .services__list {
      grid-template-columns: 1fr 1fr;
    }

    .service--sites {
      grid-column: 1 / -1;
      grid-template-columns: 0.9fr 1.1fr;
      align-items: stretch;
      min-height: 18rem;
    }

    .service--sites .service__visual {
      min-height: 100%;
    }
  }

  @media (min-width: 1100px) {
    .services {
      grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
      gap: 3.5rem;
      align-items: start;
    }

    .services :global(.intro) {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }

    .services__list {
      grid-template-columns: 1fr 1fr;
    }

    .service--ai {
      min-height: 22rem;
    }
  }
</style>
