---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section" id="products">
  <div class="container">
    <p class="section__eyebrow">{t.products.eyebrow}</p>
    <h2 class="section__title">{t.products.title}</h2>
    <p class="section__lead">{t.products.lead}</p>
    <div class="products">
      {
        t.products.items.map((item, index) => (
          <article class:list={['product', index === 0 && 'product--featured']}>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <ul class="product__includes">
              {item.includes.map((entry) => (
                <li>{entry}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .products {
    display: grid;
    gap: 1rem;
  }

  .product {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: 1.4rem 1.3rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), transparent);
    transition:
      border-color 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }

  .product:hover {
    border-color: rgba(61, 143, 173, 0.45);
    transform: translateY(-2px);
  }

  .product--featured {
    background: linear-gradient(135deg, rgba(61, 143, 173, 0.14), rgba(255, 255, 255, 0.02));
  }

  .product h3 {
    font-size: 1.15rem;
  }

  .product p {
    color: var(--color-text-muted);
  }

  .product__includes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .product__includes li {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
