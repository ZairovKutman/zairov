---
import type { Dictionary } from '../i18n';
import SectionIntro from './SectionIntro.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section" id="engineering">
  <div class="container">
    <SectionIntro
      index={t.engineering.index}
      eyebrow={t.engineering.eyebrow}
      title={t.engineering.title}
      lead={t.engineering.lead}
    />

    <div class="panel" data-reveal>
      <div class="panel__bar">
        <span>SYS / LAYERS</span>
        <span>ZAIROV · ENG</span>
      </div>
      <ol class="panel__grid">
        {
          t.engineering.items.map((item) => (
            <li>
              <span>{item.code}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .panel {
    border: 1px solid var(--line);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
      var(--surface);
    box-shadow: var(--shadow);
  }

  .panel__bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .panel__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .panel__grid li {
    padding: 1.3rem 1.15rem 1.4rem;
    border-bottom: 1px solid var(--line);
  }

  .panel__grid li:last-child {
    border-bottom: 0;
  }

  .panel__grid span {
    display: inline-block;
    margin-bottom: 0.55rem;
    padding: 0.12rem 0.4rem;
    border: 1px solid var(--line);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .panel__grid h3 {
    margin-bottom: 0.4rem;
    font-size: 1.2rem;
  }

  .panel__grid p {
    color: var(--muted);
  }

  @media (min-width: 800px) {
    .panel__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .panel__grid li {
      border-right: 1px solid var(--line);
    }

    .panel__grid li:nth-child(2n) {
      border-right: 0;
    }

    .panel__grid li:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  @media (min-width: 1100px) {
    .panel__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .panel__grid li:nth-child(2n) {
      border-right: 1px solid var(--line);
    }

    .panel__grid li:nth-child(3n) {
      border-right: 0;
    }

    .panel__grid li:nth-last-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }

    .panel__grid li:nth-last-child(-n + 3) {
      border-bottom: 0;
    }
  }
</style>
