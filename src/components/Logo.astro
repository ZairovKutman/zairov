---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  class:list={['mark', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  width="28"
  height="28"
  aria-hidden="true"
  focusable="false"
>
  <path fill="currentColor" d="M7 9h34v8H7V9Zm19 7h15L19 32H7L26 16ZM7 31.2h34V40H7v-8.8Z" />
</svg>

<style>
  .mark {
    display: block;
    width: 1.7rem;
    height: auto;
    flex-shrink: 0;
  }
</style>
