---
import type { Dictionary, Locale } from '../i18n';
import { localizePath } from '../i18n';
import Logo from './Logo.astro';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  locale: Locale;
  t: Dictionary;
}

const { locale, t } = Astro.props;
const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}${localizePath(locale)}`;

const links = [
  { href: '#about', label: t.nav.about, n: '01' },
  { href: '#products', label: t.nav.services, n: '02' },
  { href: '#cases', label: t.nav.work, n: '03' },
  { href: '#process', label: t.nav.process, n: '04' },
];
---

<header class="header" data-header>
  <div class="header__progress" aria-hidden="true">
    <span data-progress></span>
  </div>
  <div class="container header__inner">
    <a class="brand" href={home} aria-label={t.nav.home}>
      <Logo />
      <span class="brand__name">ZAIROV</span>
    </a>

    <nav class="header__nav" aria-label={t.nav.primary}>
      {
        links.map((link) => (
          <a class="header__link" href={link.href} data-nav>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <LangSwitcher locale={locale} label={t.nav.language} />
      <a class="btn btn--primary header__cta" href="#contact">
        {t.nav.contact}
      </a>
      <button
        class="header__menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span class="sr-only" data-menu-label-open>{t.nav.menu}</span>
        <span class="sr-only" data-menu-label-close hidden>{t.nav.close}</span>
        <span class="header__menu-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="header__drawer" id="mobile-nav" hidden data-menu-panel>
    <div class="container header__drawer-inner">
      <nav class="header__drawer-nav" aria-label={t.nav.mobile}>
        {
          links.map((link) => (
            <a class="header__drawer-link" href={link.href} data-nav data-menu-close>
              <span>{link.n}</span>
              {link.label}
            </a>
          ))
        }
      </nav>
      <a class="btn btn--primary header__drawer-cta" href="#contact" data-menu-close>
        {t.nav.contact}
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const panel = document.querySelector('[data-menu-panel]');
  const labelOpen = document.querySelector('[data-menu-label-open]');
  const labelClose = document.querySelector('[data-menu-label-close]');
  const main = document.querySelector('main');
  const footer = document.querySelector('footer');

  if (toggle instanceof HTMLButtonElement && panel instanceof HTMLElement) {
    const focusable = () =>
      [...panel.querySelectorAll<HTMLElement>('a, button')].filter((el) => !el.hasAttribute('disabled'));

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      document.body.classList.toggle('menu-open', open);
      toggle.classList.toggle('is-open', open);
      main?.toggleAttribute('inert', open);
      footer?.toggleAttribute('inert', open);
      if (labelOpen instanceof HTMLElement) labelOpen.hidden = open;
      if (labelClose instanceof HTMLElement) labelClose.hidden = !open;
      if (open) focusable()[0]?.focus();
      else toggle.focus();
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.querySelectorAll('[data-menu-close]').forEach((el) => {
      el.addEventListener('click', () => setOpen(false));
    });

    panel.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const items = focusable();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
    });

    window.addEventListener('resize', () => {
      if (window.matchMedia('(min-width: 1024px)').matches) setOpen(false);
    });
  }
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: transparent;
    transition:
      background 220ms var(--ease),
      border-color 220ms var(--ease),
      backdrop-filter 220ms var(--ease);
  }

  .header.is-scrolled {
    background: rgba(16, 5, 30, 0.78);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(18px);
  }

  .header__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    pointer-events: none;
  }

  .header__progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent-2), var(--accent-3));
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 2.75rem;
    justify-self: start;
  }

  .brand__name {
    font-family: var(--font-brand);
    font-weight: 500;
    font-size: 0.92rem;
    letter-spacing: 0.18em;
  }

  .header__nav {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
  }

  .header__link {
    position: relative;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 600;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.7rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 200ms var(--ease);
  }

  .header__link:hover,
  .header__link.is-current {
    color: var(--ink);
  }

  .header__link:hover::after,
  .header__link.is-current::after {
    transform: scaleX(1);
  }

  .header__actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.7rem;
  }

  .header__cta {
    display: none;
    min-height: 2.6rem;
    padding-inline: 1.15rem;
  }

  .header__menu-btn {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: rgba(246, 243, 251, 0.04);
    display: inline-grid;
    place-items: center;
    cursor: pointer;
  }

  .header__menu-icon,
  .header__menu-icon::before,
  .header__menu-icon::after {
    display: block;
    width: 1.05rem;
    height: 1.5px;
    background: var(--ink);
    position: relative;
    transition:
      transform 180ms var(--ease),
      opacity 180ms var(--ease);
  }

  .header__menu-icon::before,
  .header__menu-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .header__menu-icon::before {
    top: -6px;
  }

  .header__menu-icon::after {
    top: 6px;
  }

  .header__menu-btn.is-open .header__menu-icon {
    background: transparent;
  }

  .header__menu-btn.is-open .header__menu-icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .header__menu-btn.is-open .header__menu-icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .header__drawer {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: 40;
    background: rgba(16, 5, 30, 0.97);
    overflow: auto;
  }

  .header__drawer[hidden] {
    display: none;
  }

  .header__drawer-inner {
    display: flex;
    flex-direction: column;
    min-height: calc(100dvh - var(--header-h));
    padding-block: 1.5rem 2rem;
  }

  .header__drawer-nav {
    display: grid;
  }

  .header__drawer-link {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    font-size: clamp(1.8rem, 7vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .header__drawer-link span {
    color: var(--accent);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }

  .header__drawer-link:last-child {
    border-bottom: 1px solid var(--line);
  }

  .header__drawer-cta {
    margin-top: auto;
    width: 100%;
  }

  @media (max-width: 380px) {
    .brand__name {
      font-size: 0.78rem;
      letter-spacing: 0.1em;
    }
  }

  @media (min-width: 1024px) {
    .header__inner {
      grid-template-columns: 1fr auto 1fr;
    }

    .header__nav,
    .header__cta {
      display: inline-flex;
    }

    .header__menu-btn,
    .header__drawer {
      display: none !important;
    }
  }
</style>
