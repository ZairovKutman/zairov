---
import type { Dictionary } from '../i18n';
import SectionIntro from './SectionIntro.astro';
import ServiceIcon from './ServiceIcon.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section section--alt" id="products">
  <div class="container services">
    <SectionIntro index="02" eyebrow={t.services.eyebrow} title={t.services.title} lead={t.services.lead} />
    <ol class="services__list">
      {
        t.services.items.map((item, index) => (
          <li class={`service service--${item.id}`} data-reveal style={`--d:${index * 70}ms`}>
            <div class="service__visual" aria-hidden="true">
              <ServiceIcon id={item.id} />
            </div>
            <div class="service__body">
              <span class="service__n">{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <p class="service__meta">{item.includes.join(' · ')}</p>
              <a class="link service__go" href="#contact" data-interest={item.interest}>
                {t.services.discuss}
                <span class="link__arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .services {
    display: grid;
    gap: 2.25rem;
  }

  .services__list {
    list-style: none;
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .service {
    position: relative;
    display: grid;
    gap: 1.1rem;
    min-height: 16rem;
    padding: 1.35rem 1.3rem 1.25rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, rgba(246, 243, 251, 0.04), rgba(16, 5, 30, 0.2)),
      var(--bg-raise);
    transition:
      border-color 220ms var(--ease),
      transform 220ms var(--ease),
      box-shadow 220ms var(--ease);
  }

  .service:hover,
  .service:focus-within {
    border-color: rgba(196, 181, 253, 0.45);
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(76, 29, 149, 0.28);
  }

  .service__n {
    display: block;
    margin-bottom: 0.7rem;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .service__body h3 {
    margin-bottom: 0.5rem;
    font-size: 1.4rem;
  }

  .service__body p {
    color: var(--muted);
  }

  .service__meta {
    margin-top: 0.8rem;
    color: var(--ink) !important;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .service__go {
    margin-top: 0.35rem;
  }

  .service__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 10.5rem;
    padding: 1rem;
    overflow: hidden;
    border-radius: 0.9rem;
    border: 1px solid rgba(196, 181, 253, 0.18);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(124, 58, 237, 0.38), transparent 64%),
      linear-gradient(180deg, rgba(246, 243, 251, 0.06), rgba(16, 5, 30, 0.35));
  }

  .service__visual::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(246, 243, 251, 0.055) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(246, 243, 251, 0.055) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse at 50% 45%, #000 12%, transparent 74%);
    pointer-events: none;
  }

  .service__visual :global(.service-icon) {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    width: auto;
    height: 7.25rem;
    max-width: 100%;
    aspect-ratio: 200 / 120;
    filter: drop-shadow(0 12px 24px rgba(91, 140, 255, 0.16));
  }

  @media (prefers-reduced-motion: no-preference) {
    .service__visual :global(.service-icon) {
      transition: transform 280ms var(--ease);
    }

    .service:hover .service__visual :global(.service-icon),
    .service:focus-within .service__visual :global(.service-icon) {
      transform: translateY(-3px);
    }
  }

  @media (min-width: 800px) {
    .services__list {
      grid-template-columns: 1fr 1fr;
    }

    .service--sites {
      grid-column: 1 / -1;
      grid-template-columns: 0.9fr 1.1fr;
      align-items: stretch;
      min-height: 18rem;
    }

    .service--sites .service__visual {
      min-height: 100%;
    }

    .service--sites .service__visual :global(.service-icon) {
      width: min(100%, 17rem);
      height: auto;
    }
  }

  @media (min-width: 1100px) {
    .services {
      grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
      gap: 3.5rem;
      align-items: start;
    }

    .services :global(.intro) {
      padding-top: 0.25rem;
    }

    .services__list {
      grid-template-columns: 1fr 1fr;
    }

    .service--ai {
      min-height: 22rem;
    }
  }
</style>
