---
import type { Locale } from '../i18n';
import { localizePath } from '../i18n';

interface Props {
  locale: Locale;
  label: string;
}

const { locale, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const languages: { code: Locale; label: string }[] = [
  { code: 'ru', label: 'RU' },
  { code: 'ky', label: 'KY' },
  { code: 'en', label: 'EN' },
];
---

<nav class="lang" aria-label={label} data-lang-switcher>
  {
    languages.map((lang) => (
      <a
        class:list={['lang__link', { 'is-active': lang.code === locale }]}
        href={`${base}${localizePath(lang.code)}`}
        hreflang={lang.code}
        lang={lang.code}
        data-lang-href={`${base}${localizePath(lang.code)}`}
        aria-current={lang.code === locale ? 'true' : undefined}
      >
        {lang.label}
      </a>
    ))
  }
</nav>

<script>
  const STORAGE_KEY = 'zairov:lang-pos';
  const root = document.querySelector('[data-lang-switcher]');

  const currentSectionHash = (): string => {
    if (window.location.hash && window.location.hash !== '#top') {
      return window.location.hash;
    }

    const marker = window.scrollY + 140;
    let id = '';
    document.querySelectorAll('main section[id]').forEach((section) => {
      if (section instanceof HTMLElement && section.offsetTop <= marker) {
        id = section.id;
      }
    });

    return id && id !== 'top' ? `#${id}` : '';
  };

  const syncLangHrefs = () => {
    if (!root) return;
    const hash = currentSectionHash();
    root.querySelectorAll<HTMLAnchorElement>('a[data-lang-href]').forEach((anchor) => {
      anchor.href = `${anchor.dataset.langHref}${hash}`;
    });
  };

  const saved = sessionStorage.getItem(STORAGE_KEY);
  if (saved && !window.location.hash) {
    sessionStorage.removeItem(STORAGE_KEY);
    try {
      const { id } = JSON.parse(saved) as { id?: string };
      const el = id ? document.getElementById(id) : null;
      if (el) el.scrollIntoView({ block: 'start', behavior: 'auto' });
    } catch {
      /* ignore malformed storage */
    }
  } else if (saved) {
    sessionStorage.removeItem(STORAGE_KEY);
  }

  if (root) {
    syncLangHrefs();
    root.addEventListener('pointerenter', syncLangHrefs);
    root.addEventListener('focusin', syncLangHrefs);
    window.addEventListener('scroll', syncLangHrefs, { passive: true });

    root.querySelectorAll<HTMLAnchorElement>('a[data-lang-href]').forEach((anchor) => {
      anchor.addEventListener('pointerdown', () => {
        const hash = currentSectionHash();
        const id = hash.replace('#', '');
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify({ id }));
        anchor.href = `${anchor.dataset.langHref}${hash}`;
      });
    });
  }
</script>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
  }

  .lang__link {
    min-width: 2.4rem;
    min-height: 2.4rem;
    display: inline-grid;
    place-items: center;
    padding: 0 0.35rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .lang__link.is-active {
    color: var(--ink);
    box-shadow: inset 0 -1px 0 var(--accent);
  }

  .lang__link:hover {
    color: var(--ink);
  }
</style>
