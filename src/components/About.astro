---
import type { Dictionary } from '../i18n';
import SectionIntro from './SectionIntro.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section about" id="about">
  <div class="container about__grid">
    <div>
      <SectionIntro index="01" eyebrow={t.about.eyebrow} title={t.about.title} />
      <p class="about__text" data-reveal>{t.about.text}</p>
      <ul class="about__sectors" data-reveal>
        {
          t.solutions.items.map((item) => (
            <li class="pill">{item.title}</li>
          ))
        }
      </ul>
      <p class="about__legal" data-reveal>{t.about.legal}</p>
    </div>

    <dl class="about__facts" aria-label={t.trust.label}>
      {
        t.trust.items.map((item, index) => (
          <div data-reveal style={`--d:${index * 70}ms`}>
            <dt>{item.label}</dt>
            <dd>{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: 2.5rem;
  }

  .about__text {
    max-width: 38rem;
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.65;
  }

  .about__sectors {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .about__legal {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    max-width: 28rem;
    color: var(--ink);
    font-weight: 600;
  }

  .about__facts {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .about__facts div {
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line);
  }

  .about__facts dt {
    margin-bottom: 0.3rem;
    color: var(--ink);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .about__facts dd {
    margin: 0;
    color: var(--muted);
  }

  @media (min-width: 960px) {
    .about__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4.5rem;
      align-items: end;
    }

    .about__facts {
      border-top: 0;
    }

    .about__facts div {
      padding: 1.35rem 0 1.35rem 1.5rem;
      border-bottom: 0;
      border-left: 1px solid var(--line);
    }
  }
</style>
