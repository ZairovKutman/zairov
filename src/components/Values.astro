---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="trust-band" id="trust" aria-label={t.trust.label}>
  <div class="container">
    <dl class="trust">
      {
        t.trust.items.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .trust-band {
    border-block: 1px solid var(--line);
  }

  .trust {
    display: grid;
    margin: 0;
  }

  .trust div {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .trust div:last-child {
    border-bottom: 0;
  }

  .trust dt {
    margin-bottom: 0.25rem;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .trust dd {
    margin: 0;
    color: var(--muted);
  }

  @media (min-width: 800px) {
    .trust {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .trust div {
      padding: 1.35rem 1.25rem 1.35rem 0;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }

    .trust div:last-child {
      border-right: 0;
      padding-right: 0;
    }
  }
</style>
