---
import type { Dictionary } from '../i18n';
import SectionIntro from './SectionIntro.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section" id="expertise">
  <div class="container">
    <SectionIntro index="04" eyebrow={t.expertise.eyebrow} title={t.expertise.title} lead={t.expertise.lead} />
    <ol class="spec">
      {
        t.expertise.items.map((item, index) => (
          <li data-reveal style={`--d:${index * 50}ms`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .spec {
    list-style: none;
    display: grid;
    gap: 0;
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .spec li {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
  }

  .spec span {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 0.85rem;
  }

  .spec h3 {
    font-size: 1.25rem;
  }

  .spec p {
    color: var(--muted);
  }

  @media (min-width: 800px) {
    .spec {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .spec li {
      padding: 1.4rem 1.4rem 1.4rem 0;
    }

    .spec li:nth-child(odd) {
      border-right: 1px solid var(--line);
      padding-right: 1.4rem;
    }

    .spec li:nth-child(even) {
      padding-left: 1.4rem;
    }
  }

  @media (min-width: 1100px) {
    .spec {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .spec li,
    .spec li:nth-child(odd),
    .spec li:nth-child(even) {
      border-right: 1px solid var(--line);
      border-bottom: 0;
      padding: 1.4rem 1rem 0 0;
    }

    .spec li:last-child {
      border-right: 0;
    }
  }
</style>
