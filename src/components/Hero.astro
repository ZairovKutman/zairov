---
import type { Dictionary } from '../i18n';
import Sculpture from './Sculpture.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="hero" id="top">
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__vignette" aria-hidden="true"></div>
  <div class="container hero__layout">
    <div class="hero__copy">
      <p class="hero__badge pill">{t.hero.badge}</p>
      <h1 class="hero__title">
        <span>{t.hero.title[0]}</span>
        <span>{t.hero.title[1]}</span>
      </h1>
      <p class="hero__subtitle">{t.hero.subtitle}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#contact">
          {t.hero.ctaPrimary}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href="#cases">{t.hero.ctaSecondary}</a>
      </div>
    </div>

    <div class="hero__stage">
      <Sculpture />
      <p class="hero__fig">{t.hero.fig}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-top: var(--header-h);
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
    overflow: clip;
    background:
      radial-gradient(ellipse at 78% 42%, rgba(124, 58, 237, 0.28), transparent 42%),
      radial-gradient(ellipse at 18% 80%, rgba(91, 140, 255, 0.12), transparent 36%),
      var(--bg);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(246, 243, 251, 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(246, 243, 251, 0.045) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse at 68% 48%, #000 18%, transparent 78%);
    pointer-events: none;
  }

  .hero__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 40%, transparent 40%, rgba(16, 5, 30, 0.55) 100%);
    pointer-events: none;
  }

  .hero__layout {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .hero__badge {
    margin-bottom: 1.35rem;
    color: var(--ink);
    letter-spacing: 0.01em;
  }

  .hero__title {
    font-size: clamp(2.35rem, 6.4vw, 5.4rem);
    max-width: 11em;
    margin-bottom: 1.2rem;
    color: #fbfaff;
  }

  .hero__title span {
    display: block;
  }

  .hero__subtitle {
    max-width: 32rem;
    margin-bottom: 1.85rem;
    color: var(--muted);
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__stage {
    position: relative;
    height: 16.5rem;
    touch-action: pan-y;
  }

  .hero__fig {
    position: absolute;
    left: 0;
    bottom: 0.2rem;
    z-index: 3;
    margin: 0;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (max-width: 389px) {
    .hero__actions .btn {
      width: 100%;
    }
  }

  @media (min-width: 960px) {
    .hero__layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.95fr);
      gap: 1.5rem 2.5rem;
      min-height: calc(100svh - var(--header-h) - 3rem);
    }

    .hero__title {
      max-width: 9.4ch;
    }

    .hero__stage {
      height: min(44rem, calc(100svh - 7.5rem));
      min-height: 34rem;
    }
  }
</style>
