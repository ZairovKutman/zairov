---
interface Props {
  id: string;
}

const { id } = Astro.props;
const glow = `svc-${id}-glow`;
---

<svg
  class="service-icon"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 200 120"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={glow} x1="18" y1="16" x2="182" y2="104" gradientUnits="userSpaceOnUse">
      <stop stop-color="#5b8cff" />
      <stop offset="1" stop-color="#e84aff" />
    </linearGradient>
  </defs>

  {
    id === 'sites' && (
      <>
        <rect x="14" y="12" width="172" height="96" rx="14" fill="#12061f" stroke="rgba(246,243,251,0.22)" />
        <path d="M14 32h172" stroke="rgba(246,243,251,0.14)" />
        <circle cx="28" cy="22" r="2.4" fill="#e84aff" />
        <circle cx="37" cy="22" r="2.4" fill="#c4b5fd" />
        <circle cx="46" cy="22" r="2.4" fill="#5b8cff" />
        <rect x="28" y="44" width="78" height="8" rx="4" fill="#f6f3fb" />
        <rect x="28" y="58" width="56" height="5" rx="2.5" fill="rgba(246,243,251,0.38)" />
        <rect x="28" y="74" width="70" height="20" rx="8" fill={`url(#${glow})`} />
        <rect x="118" y="44" width="52" height="50" rx="10" fill="rgba(91,140,255,0.16)" stroke="rgba(196,181,253,0.4)" />
        <rect x="128" y="54" width="32" height="4" rx="2" fill="#f6f3fb" />
        <rect x="128" y="64" width="24" height="4" rx="2" fill="rgba(246,243,251,0.4)" />
        <rect x="128" y="76" width="28" height="8" rx="4" fill="#c4b5fd" />
      </>
    )
  }
  {
    id === 'crm' && (
      <>
        <rect x="16" y="16" width="168" height="26" rx="9" fill="#12061f" stroke="rgba(246,243,251,0.16)" />
        <circle cx="34" cy="29" r="4" fill="#e84aff" />
        <rect x="46" y="26" width="72" height="6" rx="3" fill="#f6f3fb" />
        <rect x="142" y="24" width="30" height="10" rx="5" fill="rgba(232,74,255,0.28)" />
        <rect x="16" y="48" width="168" height="26" rx="9" fill="#12061f" stroke="rgba(246,243,251,0.16)" />
        <circle cx="34" cy="61" r="4" fill="#5b8cff" />
        <rect x="46" y="58" width="58" height="6" rx="3" fill="rgba(246,243,251,0.82)" />
        <rect x="142" y="56" width="30" height="10" rx="5" fill="rgba(91,140,255,0.32)" />
        <rect x="16" y="80" width="168" height="26" rx="9" fill="#12061f" stroke="rgba(196,181,253,0.45)" />
        <circle cx="34" cy="93" r="4" fill="#34d399" />
        <rect x="46" y="90" width="84" height="6" rx="3" fill="#f6f3fb" />
        <rect x="142" y="88" width="30" height="10" rx="5" fill={`url(#${glow})`} />
      </>
    )
  }
  {
    id === 'retail' && (
      <>
        <rect x="16" y="18" width="78" height="84" rx="12" fill="#12061f" stroke="rgba(246,243,251,0.16)" />
        <rect x="26" y="28" width="26" height="26" rx="6" fill={`url(#${glow})`} />
        <rect x="58" y="28" width="26" height="26" rx="6" fill="rgba(246,243,251,0.08)" />
        <rect x="26" y="60" width="26" height="26" rx="6" fill="rgba(91,140,255,0.28)" />
        <rect x="58" y="60" width="26" height="26" rx="6" fill="rgba(246,243,251,0.08)" />
        <rect x="104" y="18" width="80" height="84" rx="12" fill="#12061f" stroke="rgba(196,181,253,0.4)" />
        <rect x="116" y="32" width="36" height="6" rx="3" fill="rgba(246,243,251,0.4)" />
        <rect x="116" y="46" width="56" height="12" rx="4" fill="#f6f3fb" />
        <path d="M116 72h56" stroke="rgba(246,243,251,0.16)" />
        <rect x="116" y="80" width="56" height="12" rx="6" fill={`url(#${glow})`} />
      </>
    )
  }
  {
    id === 'ai' && (
      <>
        <circle cx="78" cy="58" r="34" stroke="rgba(196,181,253,0.28)" />
        <circle cx="78" cy="58" r="22" stroke={`url(#${glow})`} stroke-width="1.5" />
        <circle cx="78" cy="58" r="8" fill={`url(#${glow})`} />
        <circle cx="78" cy="24" r="3.5" fill="#f6f3fb" />
        <circle cx="112" cy="74" r="3.5" fill="#5b8cff" />
        <circle cx="48" cy="78" r="3.5" fill="#e84aff" />
        <rect x="124" y="34" width="62" height="52" rx="12" fill="#12061f" stroke="rgba(246,243,251,0.18)" />
        <rect x="134" y="46" width="34" height="5" rx="2.5" fill="#f6f3fb" />
        <rect x="134" y="57" width="42" height="5" rx="2.5" fill="rgba(196,181,253,0.7)" />
        <rect x="134" y="68" width="24" height="5" rx="2.5" fill="rgba(246,243,251,0.35)" />
      </>
    )
  }
  {
    id === 'integrations' && (
      <>
        <path d="M58 60h28M114 60h28" stroke={`url(#${glow})`} stroke-width="1.5" />
        <rect x="18" y="38" width="40" height="44" rx="12" fill="#12061f" stroke="rgba(246,243,251,0.22)" />
        <rect x="28" y="52" width="20" height="4" rx="2" fill="#5b8cff" />
        <rect x="28" y="62" width="14" height="4" rx="2" fill="rgba(246,243,251,0.4)" />
        <rect x="80" y="30" width="40" height="60" rx="14" fill="#12061f" stroke={`url(#${glow})`} stroke-width="1.5" />
        <circle cx="100" cy="52" r="6" fill={`url(#${glow})`} />
        <rect x="90" y="66" width="20" height="4" rx="2" fill="#f6f3fb" />
        <rect x="142" y="38" width="40" height="44" rx="12" fill="#12061f" stroke="rgba(246,243,251,0.22)" />
        <rect x="152" y="52" width="20" height="4" rx="2" fill="#e84aff" />
        <rect x="152" y="62" width="14" height="4" rx="2" fill="rgba(246,243,251,0.4)" />
      </>
    )
  }
  {
    id === 'support' && (
      <>
        <rect x="16" y="16" width="168" height="88" rx="14" fill="#12061f" stroke="rgba(246,243,251,0.16)" />
        <path d="M32 78h136" stroke="rgba(246,243,251,0.12)" />
        <path d="M32 70c12-18 18-18 28 0s16 22 28 4 16-28 30-8 14 16 22 8 16-20 28-6" stroke={`url(#${glow})`} stroke-width="2" stroke-linecap="round" />
        <circle cx="168" cy="68" r="4" fill="#34d399" />
        <rect x="32" y="30" width="8" height="8" rx="4" fill="#34d399" />
        <rect x="46" y="31" width="48" height="6" rx="3" fill="#f6f3fb" />
      </>
    )
  }
</svg>

<style>
  .service-icon {
    display: block;
    width: auto;
    height: 7.25rem;
    aspect-ratio: 200 / 120;
  }
</style>
