---
import type { Dictionary } from '../i18n';
import SectionIntro from './SectionIntro.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section section--paper" id="process">
  <div class="container">
    <SectionIntro index="05" eyebrow={t.process.eyebrow} title={t.process.title} lead={t.process.lead} />
    <ol class="steps">
      {
        t.process.steps.map((step, index) => (
          <li data-reveal style={`--d:${index * 60}ms`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    display: grid;
    margin: 2.25rem 0 0;
    padding: 0;
    border-top: 1px solid var(--paper-line);
  }

  .steps li {
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--paper-line);
  }

  .steps span {
    display: block;
    margin-bottom: 0.55rem;
    color: var(--signal);
    font-family: var(--font-display);
    font-size: 0.85rem;
  }

  .steps h3 {
    margin-bottom: 0.35rem;
    font-size: 1.2rem;
  }

  .steps p {
    color: var(--paper-muted);
  }

  @media (min-width: 960px) {
    .steps {
      position: relative;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.25rem;
      border-top: 0;
      margin-top: 3rem;
    }

    .steps::before {
      content: '';
      position: absolute;
      top: 0.45rem;
      left: 0;
      right: 0;
      height: 1px;
      background: var(--paper-line);
    }

    .steps li {
      border-bottom: 0;
      padding: 0;
    }

    .steps span {
      position: relative;
      width: fit-content;
      margin-bottom: 1.4rem;
      padding-right: 0.7rem;
      background: var(--paper);
    }
  }
</style>
