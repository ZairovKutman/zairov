---
import type { Dictionary } from '../i18n';
import Monogram from './Monogram.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="hero" id="top">
  <div class="container hero__layout">
    <div class="hero__copy">
      <p class="hero__line">{t.hero.line}</p>
      <h1 class="hero__title">
        <span>{t.hero.title[0]}</span>
        <span>{t.hero.title[1]}</span>
      </h1>
      <p class="hero__subtitle">{t.hero.subtitle}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#contact">
          {t.hero.ctaPrimary}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href="#cases">{t.hero.ctaSecondary}</a>
      </div>
    </div>

    <div class="hero__stage" data-parallax>
      <div class="hero__mesh" data-depth style="--depth: 0.28"></div>
      <div class="hero__glow" data-depth style="--depth: 0.55"></div>
      <div class="hero__mark" data-depth style="--depth: 1">
        <div class="hero__mark-float">
          <Monogram />
        </div>
      </div>
      <p class="hero__fig">{t.hero.fig}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    align-items: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(1.75rem, 4vw, 3.5rem);
    overflow: clip;
  }

  .hero__layout {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }

  .hero__line {
    margin-bottom: 1rem;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero__title {
    font-size: clamp(2.15rem, 4.6vw, 4.35rem);
    max-width: 16em;
    margin-bottom: 1.15rem;
  }

  .hero__title span {
    display: block;
  }

  .hero__subtitle {
    max-width: 34rem;
    margin-bottom: 1.6rem;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .hero__stage {
    --dx: 0;
    --dy: 0;
    position: relative;
    height: 15.5rem;
    touch-action: pan-y;
  }

  .hero__mesh,
  .hero__glow,
  .hero__mark {
    position: absolute;
    inset: 0;
  }

  .hero__mesh {
    background-image:
      linear-gradient(to right, rgba(154, 215, 234, 0.16) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(154, 215, 234, 0.16) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: radial-gradient(ellipse at 50% 46%, #000 18%, transparent 72%);
    transform: translate3d(calc(var(--dx) * var(--depth) * 1px), calc(var(--dy) * var(--depth) * 1px), 0);
  }

  .hero__glow {
    background: radial-gradient(ellipse at 48% 42%, rgba(154, 215, 234, 0.34), rgba(154, 215, 234, 0.05) 46%, transparent 70%);
    transform: translate3d(calc(var(--dx) * var(--depth) * 1px), calc(var(--dy) * var(--depth) * 1px), 0);
  }

  .hero__mark {
    transform: translate3d(calc(var(--dx) * var(--depth) * 1px), calc(var(--dy) * var(--depth) * 1px), 0);
  }

  .hero__mark-float {
    height: 100%;
  }

  .hero__fig {
    position: absolute;
    left: 0;
    bottom: 0;
    margin: 0;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  html.is-rich .hero__mark-float {
    will-change: transform;
    animation: floaty 9s var(--ease) infinite alternate;
  }

  .hero.is-quiet .hero__mark-float {
    animation-play-state: paused;
    will-change: auto;
  }

  @keyframes floaty {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, -12px, 0);
    }
  }

  @media (max-width: 389px) {
    .hero__actions .btn {
      width: 100%;
    }
  }

  @media (min-width: 960px) {
    .hero__layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
      gap: 2rem;
    }

    .hero__title {
      max-width: 12ch;
    }

    .hero__stage {
      height: min(40rem, calc(100svh - 8rem));
      min-height: 32rem;
    }
  }
</style>
