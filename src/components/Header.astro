---
import type { Dictionary, Locale } from '../i18n';
import { localizePath } from '../i18n';
import Logo from './Logo.astro';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  locale: Locale;
  t: Dictionary;
}

const { locale, t } = Astro.props;
const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}${localizePath(locale)}`;

const links = [
  { href: '#services', label: t.nav.services },
  { href: '#work', label: t.nav.work },
  { href: '#solutions', label: t.nav.solutions },
  { href: '#about', label: t.nav.about },
  { href: '#contact', label: t.nav.contact },
];
---

<header class="header" data-header>
  <div class="header__progress" aria-hidden="true">
    <span data-progress></span>
  </div>
  <div class="container header__inner">
    <a class="header__brand" href={home} aria-label={t.nav.home}>
      <Logo />
    </a>

    <nav class="header__nav" aria-label={t.nav.primary}>
      {
        links.map((link) => (
          <a class="header__link" href={link.href}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <LangSwitcher locale={locale} />
      <a class="btn btn--primary header__cta" href="#contact">
        {t.nav.discuss}
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <button
        class="header__menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span class="sr-only" data-menu-label-open>{t.nav.menu}</span>
        <span class="sr-only" data-menu-label-close hidden>{t.nav.close}</span>
        <span class="header__menu-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="header__drawer" id="mobile-nav" hidden data-menu-panel>
  <div class="container header__drawer-inner">
    <nav class="header__drawer-nav" aria-label={t.nav.mobile}>
      {
        links.map((link, i) => (
          <a class="header__drawer-link" href={link.href} data-menu-close>
            <span>0{i + 1}</span>
            {link.label}
          </a>
        ))
      }
    </nav>
    <a class="btn btn--primary header__drawer-cta" href="#contact" data-menu-close>
      {t.nav.discuss}
      <span class="btn__arrow" aria-hidden="true">→</span>
    </a>
  </div>
</div>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const panel = document.querySelector('[data-menu-panel]');
  const labelOpen = document.querySelector('[data-menu-label-open]');
  const labelClose = document.querySelector('[data-menu-label-close]');
  const header = document.querySelector('[data-header]');
  const progress = document.querySelector('[data-progress]');
  const main = document.querySelector('main');
  const footer = document.querySelector('footer');

  if (toggle instanceof HTMLButtonElement && panel instanceof HTMLElement) {
    const focusables = () =>
      [...panel.querySelectorAll<HTMLElement>('a, button')].filter((el) => !el.hasAttribute('disabled'));

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      document.body.classList.toggle('menu-open', open);
      toggle.classList.toggle('is-open', open);
      header?.classList.toggle('is-menu', open);
      main?.toggleAttribute('inert', open);
      footer?.toggleAttribute('inert', open);
      if (labelOpen instanceof HTMLElement) labelOpen.hidden = open;
      if (labelClose instanceof HTMLElement) labelClose.hidden = !open;
      if (open) focusables()[0]?.focus();
      else toggle.focus();
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.querySelectorAll('[data-menu-close]').forEach((el) => {
      el.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
      if (event.key !== 'Tab' || toggle.getAttribute('aria-expanded') !== 'true') return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    window.addEventListener('resize', () => {
      if (window.matchMedia('(min-width: 1024px)').matches) setOpen(false);
    });
  }

  document.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const href = link.getAttribute('href');
      if (!href || href === '#') return;
      const target = document.getElementById(href.slice(1));
      if (!target) return;
      event.preventDefault();
      history.pushState(null, '', href);
      target.scrollIntoView({ block: 'start', behavior: 'smooth' });
      if (toggle instanceof HTMLButtonElement && panel instanceof HTMLElement) {
        toggle.setAttribute('aria-expanded', 'false');
        panel.hidden = true;
        document.body.classList.remove('menu-open');
        toggle.classList.remove('is-open');
        header?.classList.remove('is-menu');
        main?.removeAttribute('inert');
        footer?.removeAttribute('inert');
      }
    });
  });

  const onScroll = () => {
    if (header instanceof HTMLElement) {
      header.classList.toggle('is-scrolled', window.scrollY > 12);
    }
    if (progress instanceof HTMLElement) {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const value = max > 0 ? window.scrollY / max : 0;
      progress.style.transform = `scaleX(${Math.min(1, Math.max(0, value))})`;
    }
  };

  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid transparent;
    background: rgba(8, 11, 18, 0.55);
    backdrop-filter: blur(16px);
    transition:
      background 240ms var(--ease),
      border-color 240ms var(--ease);
  }

  .header.is-scrolled,
  .header.is-menu {
    background: rgba(8, 11, 18, 0.94);
    border-bottom-color: var(--line);
  }

  .header__progress {
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: transparent;
    overflow: hidden;
  }

  .header__progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    z-index: 2;
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: 1.35rem;
  }

  .header__link {
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 600;
    transition: color 160ms var(--ease);
  }

  .header__link:hover {
    color: var(--text);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    z-index: 2;
  }

  .header__cta {
    display: none;
    min-height: 2.6rem;
    padding-inline: 1.05rem;
    font-size: 0.88rem;
  }

  .header__menu-btn {
    width: 2.7rem;
    height: 2.7rem;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: transparent;
    display: inline-grid;
    place-items: center;
    cursor: pointer;
  }

  .header__menu-icon,
  .header__menu-icon::before,
  .header__menu-icon::after {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    background: var(--text);
    position: relative;
    transition:
      transform 180ms var(--ease),
      opacity 180ms var(--ease);
  }

  .header__menu-icon::before,
  .header__menu-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .header__menu-icon::before {
    top: -5px;
  }

  .header__menu-icon::after {
    top: 5px;
  }

  .header__menu-btn.is-open .header__menu-icon {
    background: transparent;
  }

  .header__menu-btn.is-open .header__menu-icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .header__menu-btn.is-open .header__menu-icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .header__drawer {
    position: fixed;
    inset: 0;
    z-index: 35;
    padding-top: calc(var(--header-h) + 1rem);
    background: var(--bg);
  }

  .header__drawer-inner {
    display: grid;
    gap: 2rem;
    padding-bottom: 2rem;
  }

  .header__drawer-nav {
    display: grid;
  }

  .header__drawer-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.5rem, 6vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .header__drawer-link span {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent);
    letter-spacing: 0.06em;
  }

  .header__drawer-cta {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .header__nav {
      display: flex;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .header__cta {
      display: inline-flex;
    }

    .header__menu-btn,
    .header__drawer {
      display: none !important;
    }
  }
</style>
