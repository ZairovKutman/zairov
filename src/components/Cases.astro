---
import type { Dictionary } from '../i18n';
import { caseLayouts, type CaseId } from '../data/contacts';
import SectionIntro from './SectionIntro.astro';
import CaseVisual from './CaseVisual.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;

const items = t.cases.items.map((item) => ({
  ...item,
  layout: caseLayouts[item.id as CaseId] ?? 'split',
}));

const featured = items.filter((item) => item.layout === 'feature');
const split = items.filter((item) => item.layout === 'split');
const rest = items.filter((item) => item.layout === 'wide' || item.layout === 'compact');
---

<section class="section" id="work">
  <div class="container">
    <SectionIntro index={t.cases.index} eyebrow={t.cases.eyebrow} title={t.cases.title} lead={t.cases.lead} />

    <div class="work">
      {
        featured.map((item) => (
          <article class="work__feature" data-reveal>
            <CaseVisual id={item.id} label={t.cases.visualLabel} />
            <div class="work__copy">
              <p class="work__meta">
                <span>{item.category}</span>
                <span>{item.url ? t.cases.live : t.cases.internal}</span>
              </p>
              <h3 class="display display--md">{item.name}</h3>
              <p>{item.text}</p>
              <p class="work__solves">
                <strong>{t.cases.solvesLabel}</strong>
                {item.solves}
              </p>
              {item.url ? (
                <a class="link" href={item.url} target="_blank" rel="noopener noreferrer">
                  {t.cases.visit}
                  <span class="sr-only">, {item.name}. {t.cases.newTab}</span>
                  <span class="link__arrow" aria-hidden="true">↗</span>
                </a>
              ) : (
                <span class="work__internal">{t.cases.internal}</span>
              )}
            </div>
          </article>
        ))
      }

      <div class="work__split">
        {
          split.map((item, index) => (
            <article class="work__card" data-reveal style={`--d:${index * 70}ms`}>
              <CaseVisual id={item.id} label={t.cases.visualLabel} />
              <div class="work__copy">
                <p class="work__meta">
                  <span>{item.category}</span>
                  <span>{item.url ? t.cases.live : t.cases.internal}</span>
                </p>
                <h3>{item.name}</h3>
                <p>{item.text}</p>
                <p class="work__solves">
                  <strong>{t.cases.solvesLabel}</strong>
                  {item.solves}
                </p>
                {item.url ? (
                  <a class="link" href={item.url} target="_blank" rel="noopener noreferrer">
                    {t.cases.visit}
                    <span class="sr-only">
                      , {item.name}. {t.cases.newTab}
                    </span>
                    <span class="link__arrow" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                ) : (
                  <span class="work__internal">{t.cases.internal}</span>
                )}
              </div>
            </article>
          ))
        }
      </div>

      {
        rest.map((item) => (
          <article class:list={['work__row', item.layout === 'wide' && 'work__row--wide']} data-reveal>
            <CaseVisual id={item.id} label={t.cases.visualLabel} />
            <div class="work__copy">
              <p class="work__meta">
                <span>{item.category}</span>
                <span>{item.url ? t.cases.live : t.cases.internal}</span>
              </p>
              <h3>{item.name}</h3>
              <p>{item.text}</p>
              <p class="work__solves">
                <strong>{t.cases.solvesLabel}</strong>
                {item.solves}
              </p>
              {item.url ? (
                <a class="link" href={item.url} target="_blank" rel="noopener noreferrer">
                  {t.cases.visit}
                  <span class="sr-only">
                    , {item.name}. {t.cases.newTab}
                  </span>
                  <span class="link__arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              ) : (
                <span class="work__internal">{t.cases.internal}</span>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work {
    display: grid;
    gap: 1.15rem;
  }

  .work__feature,
  .work__card,
  .work__row {
    display: grid;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .work__copy {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.4rem 1.35rem 1.55rem;
  }

  .work__copy p:not(.work__meta):not(.work__solves) {
    color: var(--muted);
  }

  .work__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .work__meta span:last-child {
    color: var(--accent);
  }

  .work__copy h3 {
    font-size: clamp(1.35rem, 2vw, 1.9rem);
  }

  .work__solves {
    color: var(--text);
    font-size: 0.98rem;
  }

  .work__solves strong {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .work__internal {
    color: var(--muted);
    font-weight: 700;
  }

  .work__split {
    display: grid;
    gap: 1.15rem;
  }

  @media (min-width: 900px) {
    .work__feature {
      grid-template-columns: 1.15fr 0.85fr;
    }

    .work__split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work__row {
      grid-template-columns: 0.9fr 1.1fr;
    }

    .work__row--wide {
      grid-template-columns: 1.2fr 0.8fr;
    }

    .work__copy {
      padding: 1.7rem 1.6rem;
    }
  }
</style>
