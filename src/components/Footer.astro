---
import type { Dictionary, Locale } from '../i18n';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  t: Dictionary;
}

const { t } = Astro.props;
const year = new Date().getFullYear();

const links = [
  { href: '#products', label: t.nav.services },
  { href: '#cases', label: t.nav.work },
  { href: '#process', label: t.nav.process },
  { href: '#about', label: t.nav.about },
  { href: '#contact', label: t.nav.contact },
];
---

<footer class="footer">
  <div class="container">
  <div class="footer__grid">
    <div class="footer__brand">
      <Logo />
      <p class="footer__name">ZAIROV</p>
      <p>{t.footer.tagline}</p>
      <p>{t.footer.place}</p>
    </div>
    <nav class="footer__nav" aria-label={t.nav.footer}>
      {
        links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </nav>
    <div class="footer__meta">
      <p>{t.footer.legal}</p>
      <ul class="footer__channels">
        <li>
          <a href={`mailto:${t.contacts.email}`}>
            {t.contacts.emailLabel}
            <span class="sr-only">, {t.contacts.email}</span>
          </a>
        </li>
        <li>
          <a href={t.contacts.whatsappHref} target="_blank" rel="noopener noreferrer">
            {t.contacts.whatsappLabel}
            <span class="sr-only">, {t.contacts.phoneDisplay}. {t.a11y.external}</span>
          </a>
        </li>
        <li>
          <a href={t.contacts.telegramHref} target="_blank" rel="noopener noreferrer">
            {t.contacts.telegramLabel}
            <span class="sr-only">, {t.contacts.telegram}. {t.a11y.external}</span>
          </a>
        </li>
      </ul>
      <p>{t.footer.note}</p>
    </div>
  </div>
  <div class="footer__bar">
    <p>© {year} ZAIROV. {t.footer.rights}</p>
    <button type="button" class="footer__privacy" data-privacy-open>
      {t.footer.privacyLabel}
    </button>
  </div>
  </div>

<dialog class="privacy" data-privacy-dialog aria-labelledby="privacy-title">
  <div class="privacy__head">
    <h2 id="privacy-title" class="privacy__title">{t.footer.privacyTitle}</h2>
    <button type="button" class="privacy__close" data-privacy-close>
      {t.footer.privacyClose}
    </button>
  </div>
  <div class="privacy__body">
    {
      t.footer.privacy.map((item) => {
        const email = t.contacts.email;
        const parts = item.body.split(email);
        return (
          <section>
            <h3>{item.heading}</h3>
            <p>
              {parts.length === 2 ? (
                <>
                  {parts[0]}
                  <a href={`mailto:${email}`}>{email}</a>
                  {parts[1]}
                </>
              ) : (
                item.body
              )}
            </p>
          </section>
        );
      })
    }
  </div>
</dialog>
</footer>

<script>
  const dialog = document.querySelector('[data-privacy-dialog]');
  const open = document.querySelector('[data-privacy-open]');
  const close = document.querySelector('[data-privacy-close]');

  if (dialog instanceof HTMLDialogElement && open instanceof HTMLButtonElement) {
    open.addEventListener('click', () => {
      if (dialog.open) dialog.close();
      else dialog.showModal();
    });

    if (close instanceof HTMLButtonElement) {
      close.addEventListener('click', () => dialog.close());
    }

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      open.focus();
    });
  }
</script>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4rem);
    background: var(--bg);
  }

  .footer__grid {
    display: grid;
    gap: 2rem;
  }

  .footer__brand {
    display: grid;
    justify-items: start;
    gap: 0.45rem;
    color: var(--muted);
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--ink);
  }

  .footer__nav {
    display: grid;
    gap: 0.35rem;
  }

  .footer__nav a {
    width: fit-content;
    min-height: 2.5rem;
    display: inline-flex;
    align-items: center;
    font-weight: 600;
  }

  .footer__nav a:hover {
    color: var(--accent);
  }

  .footer__meta {
    display: grid;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .footer__meta p:first-child {
    color: var(--ink);
    font-weight: 600;
  }

  .footer__channels {
    list-style: none;
    margin: 0.35rem 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }

  .footer__channels a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    width: fit-content;
    color: var(--ink);
    font-weight: 600;
  }

  .footer__channels a:hover {
    color: var(--accent);
  }

  .footer__bar {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.15rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    padding-top: 1.15rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.95rem;
  }

  .footer__privacy {
    width: fit-content;
    min-height: 2.25rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-weight: 600;
    text-align: start;
    cursor: pointer;
  }

  .footer__privacy:hover {
    color: var(--accent);
  }

  .privacy {
    width: min(36rem, calc(100% - 2rem));
    max-height: min(85vh, 40rem);
    margin: auto;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--paper-ink);
  }

  .privacy[open] {
    display: flex;
    flex-direction: column;
  }

  .privacy::backdrop {
    background: rgba(11, 15, 20, 0.72);
  }

  .privacy__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.25rem 0.85rem;
  }

  .privacy__title {
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    line-height: 1.15;
  }

  .privacy__close {
    flex: none;
    min-height: 2.25rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--paper-ink);
    font-weight: 600;
    cursor: pointer;
  }

  .privacy__close:hover {
    color: var(--signal);
  }

  .privacy__body {
    display: grid;
    gap: 1.15rem;
    min-height: 0;
    overflow: auto;
    padding: 0 1.25rem 1.5rem;
  }

  .privacy__body h3 {
    margin-bottom: 0.3rem;
    font-size: 0.95rem;
  }

  .privacy__body p {
    color: var(--paper-muted);
    line-height: 1.5;
  }

  .privacy__body a {
    color: var(--signal);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (min-width: 800px) {
    .footer__grid {
      grid-template-columns: 1.3fr 0.8fr 1.1fr;
      align-items: start;
    }

    .footer__bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
