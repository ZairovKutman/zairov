---
interface Props {
  class?: string;
  variant?: 'lockup' | 'mark';
}

const { class: className = '', variant = 'lockup' } = Astro.props;
const isMark = variant === 'mark';
---

<span class:list={['logo', isMark && 'logo--mark', className]}>
  <svg
    class="logo__mark"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 48 48"
    width={isMark ? 34 : 28}
    height={isMark ? 34 : 28}
    aria-hidden="true"
    focusable="false"
  >
    <path fill="currentColor" d="M7 9h34v8H7V9Zm19 7h15L19 32H7L26 16ZM7 31.2h34V40H7v-8.8Z"></path>
  </svg>
  {
    !isMark && (
      <span class="logo__word" aria-hidden="true">
        ZAIROV
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text);
    flex-shrink: 0;
  }

  .logo__mark {
    display: block;
    flex-shrink: 0;
  }

  .logo__word {
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    line-height: 1;
  }
</style>
